# Copy to backend/.env (git-ignored; never commit it) or export as environment variables.
# Real environment variables override values in .env.
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database: Supabase PostgreSQL ------------------------------------------
# See backend/database/README.md for which Supabase connection to use.
# Use EITHER the DB_* variables below OR DATABASE_URL, never both.
# Values come from Supabase Dashboard -> your project -> Connect.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
# Least-privilege role created by backend/database/10_create_app_role.sql.
# Session pooler (IPv4, recommended for local development): fmsc_app.<project-ref>
# Direct connection (IPv6 only unless the IPv4 add-on is enabled): fmsc_app
DB_USER=fmsc_app.replace-with-your-project-ref
DB_PASSWORD=replace-with-the-fmsc_app-password
# Session pooler host, e.g. aws-<n>-<region>.pooler.supabase.com (copy it exactly from Connect)
DB_HOST=replace-with-your-supabase-pooler-host
# 5432 = direct or session pooler; 6543 = transaction pooler (prepared statements are then disabled)
DB_PORT=5432
# require = encrypted; verify-full also checks the certificate (needs DB_SSLROOTCERT)
DB_SSLMODE=require
DB_SSLROOTCERT=
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60
# direct | session | transaction (auto-detected: port 6543 = transaction)
DB_POOL_MODE=

# Connection pool shared by all request threads (default on). Reusing connections
# avoids a new TLS handshake + login per request (~3.7 s to a distant Supabase region).
DB_POOL=true
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=15
# true = test each connection before use (+1 network round trip per request)
DB_POOL_CHECK=false

# Alternative to DB_*: one URI (URL-encode special characters in the password).
# DATABASE_URL=postgresql://fmsc_app.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Revoke Supabase Data API access and enable RLS after every migrate (keep true).
FMSC_SUPABASE_HARDEN=true

# Tests never use Supabase. Run them with FMSC_DB_ENGINE=sqlite, or against a
# local PostgreSQL by overriding DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# The older POSTGRES_DB/USER/PASSWORD/HOST/PORT names are still accepted.

# --- CORS (only needed for the Flutter web build) ----------------------------
# Comma-separated exact origins. In DEBUG, any http://localhost:<port> is also
# allowed (flutter run -d chrome); set CORS_ALLOW_LOCALHOST=false to stop that.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_LOCALHOST=true

# API requests slower than this (ms) are logged as SLOW by the request timing log.
FMSC_SLOW_REQUEST_MS=1000

# Demo accounts (python manage.py seed_demo_users) are created only when
# DJANGO_DEBUG=true, unless this is set for an intentional demo environment.
# FMSC_ALLOW_DEMO_USERS=false

# API docs (/api/docs/, /api/redoc/, /api/schema/): public when DEBUG, sign-in required otherwise.
# FMSC_PUBLIC_API_DOCS=false

# Private attachment storage (must NOT be served by the web server)
FMSC_PRIVATE_MEDIA_ROOT=

# Case policy (all optional; defaults shown)
FMSC_MAX_IMAGE_MB=5
FMSC_MAX_VIDEO_MB=50
FMSC_MAX_ATTACHMENTS_PER_CASE=10
FMSC_VERIFICATION_WINDOW_DAYS=7
FMSC_REOPEN_WINDOW_DAYS=14
FMSC_ESCALATION_LEVEL2_AFTER_HOURS=48
FMSC_DUPLICATE_WINDOW_DAYS=30
FMSC_DUPLICATE_THRESHOLD=0.45

# Throttling
FMSC_THROTTLE_CASE_SUBMIT=10/hour
FMSC_THROTTLE_ATTACHMENT_UPLOAD=40/hour
FMSC_THROTTLE_LOGIN=20/hour
FMSC_THROTTLE_PASSWORD_CHANGE=10/hour
FMSC_THROTTLE_REPORT_EXPORT=30/hour

# Authentication (Member B)
FMSC_TOKEN_TTL_HOURS=12

# Notifications (Member B). In-app notifications are always on; email copies are opt-in.
FMSC_EMAIL_NOTIFICATIONS=false
FMSC_REMINDER_HOURS_BEFORE_DEADLINE=24
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=FMSC Cases <no-reply@example.lk>
