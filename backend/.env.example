# Copy to backend/.env (never commit the real file) or export as environment variables.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL (mandatory database)
POSTGRES_DB=fmsc_cases
POSTGRES_USER=fmsc
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Private attachment storage (must NOT be served by the web server)
FMSC_PRIVATE_MEDIA_ROOT=

# Case policy (all optional; defaults shown)
FMSC_MAX_IMAGE_MB=5
FMSC_MAX_VIDEO_MB=50
FMSC_MAX_ATTACHMENTS_PER_CASE=10
FMSC_VERIFICATION_WINDOW_DAYS=7
FMSC_REOPEN_WINDOW_DAYS=14
FMSC_ESCALATION_LEVEL2_AFTER_HOURS=48
FMSC_DUPLICATE_WINDOW_DAYS=30
FMSC_DUPLICATE_THRESHOLD=0.45

# Throttling
FMSC_THROTTLE_CASE_SUBMIT=10/hour
FMSC_THROTTLE_ATTACHMENT_UPLOAD=40/hour
